{
  "manifest_version": 3,

  "name": "YouTube Study Mode",

  "description": "Study-focused YouTube customization",

  "version": "1.0.0",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://*.youtube.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],

      "js": [
        "content.js"
      ],

      "css": [
        "styles.css"
      ]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],

      "matches": [
        "https://*.youtube.com/*"
      ]
    }
  ]
}